# Kingdom IDE — how plans get drafted.
#
# Copy to `.kingdom.env` (gitignored) and edit. Real environment variables
# take precedence, so a one-off override still works without editing this.
#
# With nothing set, the picker offers whatever a credential unlocks, and falls
# back to the offline mock model. That is deliberate: a fresh clone works with
# no credential and no network, because the mock is simply the only model left
# in the list rather than a special mode.

# Which model the picker OPENS on, as a namespaced id: `mock`, or
# `copilot/<name>`. Optional — without it the King opens on the best model
# available, which is a recommended one where a credential works and the mock
# where none does. He chooses per plan in the dock either way, and that choice
# is remembered in his browser.
#KINGDOM_MODEL=copilot/claude-opus-5

# The viewport a plan's browser opens at, as WIDTHxHEIGHT. Defaults to
# 1440x900, which clears every width Kingdom's own layout folds at — so a plan
# checking its work sees the full interface without resizing first. Set this
# only to test a narrow layout on purpose.
#KINGDOM_BROWSER_VIEWPORT=1024x768

# --- Credentials: pick ONE of the two paths below --------------------------

# 1. A token you already hold. Takes priority, and no subprocess is spawned.
#KINGDOM_API_KEY=gho_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. A command that prints a token. Used when KINGDOM_API_KEY is unset;
#    this is the default for Copilot models, so it needs no setting.
#
#    Contract: the LAST NON-EMPTY LINE OF STDOUT is the token. Anything on
#    stderr is treated as diagnostics and ignored, which is what lets a chatty
#    helper like `agency` work unmodified.
#KINGDOM_API_KEY_HELPER=agency auth github

# How long a minted token is reused before the helper runs again. Default 1h.
#KINGDOM_API_KEY_HELPER_TTL_MS=3600000

# --- The Proving Grounds: working on Kingdom IDE with Kingdom IDE -----------

# Refuse to open any folder outside the sandbox root. Set this whenever you are
# using Kingdom IDE to build Kingdom IDE, so "I meant to open the fake one" is
# enforced by the server rather than remembered by you.
#KINGDOM_SANDBOX=1

# Where seeded realms live. Defaults to ~/.kingdom/realms.
#KINGDOM_SANDBOX_ROOT=/tmp/kingdom-realms

# Where Kingdom keeps its own records: durable settings, and one folder of plans
# per kingdom. Defaults to ~/.kingdom. Point it somewhere else to keep a
# rehearsal session's plans away from your real ones.
#KINGDOM_HOME=/tmp/kingdom-profile

# Open this realm at startup, instead of reopening whichever kingdom you last
# had open. Seeded on first use and instant thereafter. Worth setting under
# `cargo leptos watch`, where every save restarts the server.
#KINGDOM_REALM=kingdom-mirror
