# Kingdom IDE — how plans get drafted.
#
# Copy to `.kingdom.env` (gitignored) and edit. Real environment variables
# take precedence, so a one-off override still works without editing this.
#
# With nothing set, the offline mock model drafts every plan. That is
# deliberate: a fresh clone works with no credential and no network.

# mock (default) | copilot
#
# This is only the model the picker OPENS on. The King chooses per plan in the
# dock, and that choice is remembered in his browser.
KINGDOM_MODEL_PROVIDER=copilot

# Which model to open on when the provider is copilot. Optional; defaults to
# claude-sonnet-4.6. Everything Copilot serves is listed in the picker either
# way, so this only decides the starting point.
#KINGDOM_MODEL=claude-sonnet-4.6

# --- Credentials: pick ONE of the two paths below --------------------------

# 1. A token you already hold. Takes priority, and no subprocess is spawned.
#KINGDOM_API_KEY=gho_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. A command that prints a token. Used when KINGDOM_API_KEY is unset;
#    this is the default for the copilot provider, so it needs no setting.
#
#    Contract: the LAST NON-EMPTY LINE OF STDOUT is the token. Anything on
#    stderr is treated as diagnostics and ignored, which is what lets a chatty
#    helper like `agency` work unmodified.
#KINGDOM_API_KEY_HELPER=agency auth github

# How long a minted token is reused before the helper runs again. Default 1h.
#KINGDOM_API_KEY_HELPER_TTL_MS=3600000

# --- The Proving Grounds: working on Kingdom IDE with Kingdom IDE -----------

# Refuse to open any folder outside the sandbox root. Set this whenever you are
# using Kingdom IDE to build Kingdom IDE, so "I meant to open the fake one" is
# enforced by the server rather than remembered by you.
#KINGDOM_SANDBOX=1

# Where seeded realms live. Defaults to .kingdom/realms (already gitignored).
#KINGDOM_SANDBOX_ROOT=/tmp/kingdom-realms
